<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="M_PI"                             value="3.14159274"/>

  <link name="camera_link">
    <visual>
      <!--MX_001/MX_001.Part__Feature001.-->
      <origin rpy="${M_PI} 0 ${-M_PI/2}" xyz="0.0 0.050 0.047"/>
      <geometry>
        <mesh filename="package://omnirobot_description/meshes/c920_Camera.dae"/>
      </geometry>
    </visual>

    <collision>
      <origin rpy="0 0 0" xyz="-0.015 0.0 0.037"/>
      <geometry>
        <box size="0.03 0.06 0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <origin rpy="0 0 0" xyz="-0.015 0.0 0.037"/>
      <inertia ixx="1e-4" ixy="0.0" ixz="0.0"
              iyy="1e-4" iyz="0.0"
              izz="1e-4"/>
    </inertial>

  </link>
  <joint name="camera_base2_Joint" type="fixed">
    <parent link="l_Body001"/>
    <child link="camera_link"/>
    <origin rpy="0 0 0" xyz="0.08 0 0"/>
  </joint>
  
</robot>
