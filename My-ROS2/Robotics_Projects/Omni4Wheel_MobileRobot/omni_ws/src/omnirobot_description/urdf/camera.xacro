<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="camera_link">
    <visual>
      <!--MX_001/MX_001.Part__Feature001.-->
      <origin rpy="${M_PI} 0 -${M_PI/2}" xyz="0.0 0.050 0.047"/>
      <geometry>
        <mesh filename="file:///home/sbzrgn/Desktop/My-ROS2_Projects/My-ROS2/Omni4Wheel_MobileRobot/omni_ws/src/omnirobot_description/meshes/c920_Camera.dae"/>
      </geometry>
    </visual>
  </link>
  <joint name="camera_base2_Joint" type="fixed">
    <parent link="l_Body001"/>
    <child link="camera_link"/>
    <origin rpy="0 0 0" xyz="0.08 0 0"/>
  </joint>

  <!-- Simplified camera for gz-sim -->
  <gazebo reference="camera_link">
    <pose>0 1 0 0 0 0</pose>
    <sensor name="camera_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>10.0</update_rate>
      <visualize>true</visualize>
      <topic>/camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
        <width>320</width>
        <height>240</height>
        <format>R8G8B8</format>
        </image>
      </camera>
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </sensor>
  </gazebo>

</robot>
